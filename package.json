{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,icons -c cyan,magenta \"next dev\" \"pnpm run watch:icon-types\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "generate:icon-types": "python scripts/generate_icon_values.py",
    "watch:icon-types": "chokidar \"src/consts/icons.tsx\" -c \"pnpm run generate:icon-types\" --initial"
  },
  "dependencies": {
    "@k3vndev/react-carousel": "^1.0.3",
    "clsx": "^2.1.1",
    "next": "16.2.4",
    "nodemailer": "^8.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
